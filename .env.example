# Telegram Bot Credentials
# Replace with your actual bot token obtained from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Telegram MTProto Credentials from https://my.telegram.org
# Unlocks native 2000 MB (2 GB) uploads directly through Telegram Data Centers without chunking or compression
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: Local Telegram Bot API Server URL (for uploading files up to 2000 MB / 2 GB without 50 MB cloud limit)
# TELEGRAM_API_SERVER=http://localhost:8081

# Administrator Telegram User ID (obtain from @userinfobot)
# Multiple IDs can be separated by commas (e.g. 2063913663,123456789)
ADMIN_IDS=2063913663

# Media Processing Limits
MAX_UPLOAD_SIZE_MB=2000
MAX_DURATION_SECONDS=14400
MAX_CONCURRENT_DOWNLOADS=3

# Rate Limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=10

# YouTube Cookies (Optional for Cloud / PaaS deployments like Railway, Render, Heroku)
# Base64 string of cookies.txt (generate via: base64 -w 0 cookies.txt)
# YOUTUBE_COOKIES_BASE64=
# Or raw cookie text:
# YOUTUBE_COOKIES=
