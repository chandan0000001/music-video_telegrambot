# Telegram Bot Credentials
# Replace with your actual bot token obtained from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Administrator Telegram User ID (obtain from @userinfobot)
# Multiple IDs can be separated by commas (e.g. 2063913663,123456789)
ADMIN_IDS=2063913663

# Media Processing Limits
MAX_UPLOAD_SIZE_MB=2000
MAX_DURATION_SECONDS=14400
MAX_CONCURRENT_DOWNLOADS=3

# Rate Limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=10

# Optional: Telegram MTProto Credentials from https://my.telegram.org
# Unlocks native 2000 MB (2 GB) uploads directly through Telegram Data Centers without chunking or compression
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: Local Telegram Bot API Server URL (for uploading files up to 2000 MB without 50 MB cloud limit)
# TELEGRAM_API_SERVER=http://localhost:8081

# Google Pay & UPI Payment Configuration
PAYMENT_UPI_ID=your_upi_id@okaxis
PAYMENT_MERCHANT_NAME=Music & Video Bot
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Video Quality & Subscription Pricing (INR)
PRICE_SINGLE_720P=19
PRICE_SINGLE_1080P=27

# Subscription Tiers (Normal, Go, Pro, Ultra, Max)
PRICE_TIER_GO=35
LIMIT_TIER_GO_DAILY=20
DAYS_TIER_GO=7

PRICE_TIER_PRO=100
LIMIT_TIER_PRO_DAILY=45
DAYS_TIER_PRO=30

PRICE_TIER_ULTRA=299
LIMIT_TIER_ULTRA_DAILY=80
DAYS_TIER_ULTRA=90

PRICE_TIER_MAX=799
LIMIT_TIER_MAX_DAILY=150
DAYS_TIER_MAX=365

ORDER_EXPIRY_MINUTES=10

# Audio & Video Encoding Settings (Optional Overrides, comma-separated)
# SUPPORTED_AUDIO_FORMATS=MP3,M4A,WAV
# SUPPORTED_AUDIO_QUALITIES=128,192,320
# SUPPORTED_VIDEO_FORMATS=MP4
# SUPPORTED_VIDEO_RESOLUTIONS=144p,240p,360p,480p,720p,1080p,1440p

# YouTube Cookies (Optional for Cloud / PaaS deployments like Railway, Render, Heroku)
# Base64 string of cookies.txt (generate via: base64 -w 0 cookies.txt)
# YOUTUBE_COOKIES_BASE64=
# Or raw cookie text:
# YOUTUBE_COOKIES=
